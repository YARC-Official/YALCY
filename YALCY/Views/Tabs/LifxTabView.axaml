<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YALCY.ViewModels"
             xmlns:components="clr-namespace:YALCY.Views.Components"
             x:Class="YALCY.Views.Tabs.LifxTabView" x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource AppPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button, ComboBox, NumericUpDown"><Setter Property="CornerRadius" Value="7" /></Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20" Spacing="12">
            <components:TabHeroHeader HeaderTitle="LIFX Lighting" Subtitle="Song colors and individually mapped zones over your local network" IconData="{StaticResource IconLifx}">
                <components:TabHeroHeader.BadgeContent>
                    <StackPanel>
                        <ToggleSwitch IsChecked="{Binding LifxEnabledSetting.IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding LifxEnabledSetting.ToggleButtonContent}" Classes="hint" />
                    </StackPanel>
                </components:TabHeroHeader.BadgeContent>
            </components:TabHeroHeader>
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Output &amp; feel" />
                    <TextBlock Classes="hint" Text="Disable LIFX output to change configuration or test colors. Keep your lights powered on and on the same local network." />
                    <StackPanel Spacing="10" IsEnabled="{Binding !LifxEnabledSetting.IsEnabled}">
                        <ToggleSwitch Content="Whole-light song colors" IsChecked="{Binding LifxOptions.WholeLightMode, Mode=TwoWay}" />
                        <TextBlock Classes="hint" Text="On: every included light changes color with the song, including orange, cyan, purple and white. Off: each zone follows its assigned Stage Kit LED. Existing mappings are retained." />
                        <UniformGrid Columns="{Binding GridColumns4, FallbackValue=4}">
                            <Border Classes="tile"><StackPanel Spacing="8"><TextBlock Text="Brightness (%)" /><NumericUpDown Minimum="0" Maximum="100" Value="{Binding LifxOptions.Brightness, Mode=TwoWay}" /></StackPanel></Border>
                            <Border Classes="tile"><StackPanel Spacing="8"><TextBlock Text="Color fade (ms)" /><NumericUpDown Minimum="0" Maximum="5000" Increment="25" Value="{Binding LifxOptions.TransitionMs, Mode=TwoWay}" /></StackPanel></Border>
                            <Border Classes="tile"><StackPanel Spacing="8"><TextBlock Text="Discovery window (s)" /><NumericUpDown Minimum="1" Maximum="10" Value="{Binding LifxOptions.DiscoverySeconds, Mode=TwoWay}" /></StackPanel></Border>
                            <Border Classes="tile"><StackPanel Spacing="8"><TextBlock Text="Rediscover every (s)" /><NumericUpDown Minimum="10" Maximum="3600" Value="{Binding LifxOptions.RediscoverySeconds, Mode=TwoWay}" /></StackPanel></Border>
                        </UniformGrid>
                        <CheckBox Content="Automatically rediscover lights while enabled" IsChecked="{Binding LifxOptions.AutoDiscover, Mode=TwoWay}" />
                        <TextBlock Text="Included lights" FontWeight="SemiBold" />
                        <TextBox Watermark="All discovered lights, or comma-separated labels, IPs or serials" Text="{Binding LifxOptions.IncludeLights, Mode=TwoWay}" />
                        <TextBlock Classes="hint" Text="The filter applies to both output modes and color tests. It selects discovered lights; it does not bypass discovery." />
                        <StackPanel IsVisible="{Binding !LifxOptions.WholeLightMode}" Spacing="6">
                            <TextBlock Text="Stage Kit strobe behavior" FontWeight="SemiBold" />
                            <WrapPanel>
                                <RadioButton Content="Strobe command" GroupName="LifxStrobeMode" Margin="0,0,20,0" IsChecked="{Binding LifxStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}" />
                                <RadioButton Content="Manual flash" GroupName="LifxStrobeMode" IsChecked="{Binding LifxStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock IsVisible="{Binding LifxOptions.WholeLightMode}" Classes="hint" Text="Song-color strobe uses BPM-timed manual flashes. Blackouts and output safety suppression still apply." />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Discover &amp; test" />
                    <WrapPanel>
                        <Button Content="Discover lights" Command="{Binding DiscoverLifxDevicesCommand}" Margin="0,0,12,6" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !LifxEnabledSetting.IsEnabled}">
                            <ComboBox ItemsSource="{Binding LifxTestColors}" SelectedItem="{Binding LifxTestColor, Mode=TwoWay}" MinWidth="110" />
                            <Button Content="Test for 2 seconds" Command="{Binding TestLifxColorCommand}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding LifxStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LifxMessage}" Classes="hint" />
                    <TextBlock Classes="hint" Text="Tests use the brightness and fade settings, then restore original colors and power. See the Log panel for discovery and send details." />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Devices &amp; zone assignments" />
                    <TextBlock Classes="hint" Text="Discovery lists devices below. In Stage Kit mode, map zones to Blue, Green, Yellow, Red or Strobe. Unassigned zones are left alone. Whole-light mode uses the included-lights filter instead." />
                    <ItemsControl ItemsSource="{Binding LifxDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LifxDeviceViewModel">
                                <Border Classes="tile">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding DeviceSummary}" Classes="hint" />
                                        <TextBlock Text="{Binding Serial}" Classes="hint" />
                                        <ItemsControl ItemsSource="{Binding Zones}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LifxZoneViewModel">
                                                    <Grid ColumnDefinitions="100,*" Margin="0,3">
                                                        <TextBlock Text="{Binding ZoneLabel}" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableStageLights}" SelectedItem="{Binding SelectedStageLight, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
