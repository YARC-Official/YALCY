<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YALCY.ViewModels"
             xmlns:components="clr-namespace:YALCY.Views.Components"
             x:Class="YALCY.Views.Tabs.HomeAssistantTabView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Hero Header -->
            <components:TabHeroHeader Grid.Row="0"
                                      Margin="0,0,0,16"
                                      HeaderTitle="Home Assistant Integration"
                                      Subtitle="Control smart home lights, strips and bulbs directly via Home Assistant REST API"
                                      IconData="{StaticResource IconHomeAssistant}">
                <components:TabHeroHeader.BadgeContent>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ToggleSwitch ToolTip.Tip="{Binding HomeAssistantEnabledSetting.ToolTip}"
                                      IsChecked="{Binding HomeAssistantEnabledSetting.IsEnabled, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      HorizontalAlignment="Right"
                                      Margin="0" />
                        <TextBlock Text="{Binding HomeAssistantEnabledSetting.ToggleButtonContent}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </components:TabHeroHeader.BadgeContent>
            </components:TabHeroHeader>

            <!-- Row 1: Two Column Layout -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Instance Connection Card -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppPanelBackground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,16,0">
                    <StackPanel Spacing="16">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Instance Connection"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBlock Text="Configure Home Assistant REST API endpoint"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Setup & Requirements Panel -->
                        <Border Background="{DynamicResource AppInputBackground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Setup &amp; Requirements"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="• Enter your Home Assistant URL (e.g. http://homeassistant.local:8123)"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="22,0,0,0"/>
                                <TextBlock Text="• Generate a Long-Lived Access Token in your HA Profile"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="22,0,0,0"/>
                                <TextBlock Text="• Discover or add entities and assign only the lights YALCY should control"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="22,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- URL Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Home Assistant URL"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBox Text="{Binding HomeAssistantUrl, Mode=TwoWay}"
                                     Watermark="http://homeassistant.local:8123"
                                     CornerRadius="7"
                                     Height="36"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Access Token Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Long-Lived Access Token"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBox Text="{Binding HomeAssistantAccessToken, Mode=TwoWay}"
                                     Watermark="Paste your long-lived access token"
                                     PasswordChar="•"
                                     CornerRadius="7"
                                     Height="36"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Strobe Behavior Segmented Toggle -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Strobe behavior"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                            <Grid ColumnDefinitions="*,*">
                                <RadioButton Grid.Column="0"
                                             Content="Strobe command"
                                             GroupName="HomeAssistantStrobeMode"
                                             IsChecked="{Binding HomeAssistantStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                             Classes="SegmentedToggle"
                                             HorizontalAlignment="Stretch"
                                             Margin="0,0,3,0"/>
                                <RadioButton Grid.Column="1"
                                             Content="Manual flash"
                                             GroupName="HomeAssistantStrobeMode"
                                             IsChecked="{Binding HomeAssistantStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                             Classes="SegmentedToggle"
                                             HorizontalAlignment="Stretch"
                                             Margin="3,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Status Badge -->
                        <Border Background="{DynamicResource AppInputBackground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                ToolTip.Tip="{Binding HomeAssistantStatus}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HomeAssistantStatus}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMuted}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Error Message Badge (if any) -->
                        <Border Background="#2A1515"
                                BorderBrush="#DC2626"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                IsVisible="{Binding HomeAssistantMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HomeAssistantMessage}"
                                           FontSize="11"
                                           Foreground="#EF4444"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right Column: Light Entities Card -->
                <Border Grid.Column="1"
                        Background="{DynamicResource AppPanelBackground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Configured Light Entities"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBlock Text="Map Home Assistant entities to Stage Kit cues"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="🔍 Discover HA Lights"
                                    Command="{Binding DiscoverHomeAssistantLightsCommand}"
                                    CornerRadius="7"
                                    Height="36"
                                    Padding="14,0"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Quick Add Entity Bar -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource AppInputBackground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,16">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <TextBox Grid.Column="0"
                                         Text="{Binding HomeAssistantEntityToAdd, Mode=TwoWay}"
                                         Watermark="light.living_room_ceiling"
                                         CornerRadius="7"
                                         Height="36"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                        Content="➕ Add Entity"
                                        Command="{Binding AddHomeAssistantEntityCommand}"
                                        CornerRadius="7"
                                        Height="36"
                                        Padding="14,0"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lights List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                            <ItemsControl ItemsSource="{Binding HomeAssistantLights}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HomeAssistantLightViewModel">
                                        <Border Background="{DynamicResource AppCardBackground}"
                                                BorderBrush="{DynamicResource AppBorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource SystemAccentColor}"
                                                        Width="36"
                                                        Height="36"
                                                        CornerRadius="8"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <PathIcon Data="{StaticResource IconHomeAssistant}"
                                                              Width="18"
                                                              Height="18"
                                                              Foreground="{DynamicResource SystemAccentContrastBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource AppTextPrimary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding EntityId}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppTextMuted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Background="{DynamicResource AppInputBackground}"
                                                        BorderBrush="{DynamicResource AppBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,4"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding State}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextSecondary}"/>
                                                </Border>

                                                <ComboBox Grid.Column="3"
                                                          ItemsSource="{Binding AvailableStageLights}"
                                                          SelectedItem="{Binding SelectedStageLight, Mode=TwoWay}"
                                                          CornerRadius="7"
                                                          Width="180"
                                                          Height="34"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
