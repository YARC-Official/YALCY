<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YALCY.ViewModels"
             xmlns:components="clr-namespace:YALCY.Views.Components"
             xmlns:hid="clr-namespace:HidSharp;assembly=HidSharp"
             x:Class="YALCY.Views.Tabs.StageKitTabView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Hero Header -->
            <components:TabHeroHeader Grid.Row="0"
                                      Margin="0,0,0,16"
                                      HeaderTitle="StageKit Hardware Integration"
                                      Subtitle="Official Xbox 360 Rock Band StageKit controller, light pods, strobe dome and fog unit"
                                      IconData="{StaticResource IconStageKit}">
                <components:TabHeroHeader.BadgeContent>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ToggleSwitch ToolTip.Tip="{Binding StageKitEnabledSetting.ToolTip}"
                                      IsChecked="{Binding StageKitEnabledSetting.IsEnabled, Mode=TwoWay}"
                                      OnContent=""
                                      OffContent=""
                                      HorizontalAlignment="Right"
                                      Margin="0" />
                        <TextBlock Text="{Binding StageKitEnabledSetting.ToggleButtonContent}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </components:TabHeroHeader.BadgeContent>
            </components:TabHeroHeader>

            <!-- Row 1: Two Column Layout -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controller Hardware Specifications -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppPanelBackground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,16,0">
                    <StackPanel Spacing="16">
                        <!-- Card Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="StageKit Controller Setup"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBlock Text="Hardware overview and stage lighting pods"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Hardware Architecture / Specifications -->
                        <Border Background="{DynamicResource AppInputBackground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hardware Specifications"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="• 32 multi-color LEDs organized into 4 distinct physical stage pods"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="22,0,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="• High-intensity central strobe dome with variable pulse rates"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="22,0,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="• Auxiliary port for synchronized Rock Band fog machine control"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="22,0,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="• Native USB HID protocol automatically handled with zero latency"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Margin="22,0,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 4 Pod Layout Visualizer Reference -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Stage Pod Channel Mapping"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <!-- Blue Pod -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Background="{DynamicResource AppCardBackground}"
                                        BorderBrush="#3B82F6"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="#3B82F6" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Blue Pod" FontSize="11" FontWeight="Bold" Foreground="#3B82F6"/>
                                            <TextBlock Text="LEDs 1–8" FontSize="10" Foreground="{DynamicResource AppTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Green Pod -->
                                <Border Grid.Row="0" Grid.Column="1"
                                        Background="{DynamicResource AppCardBackground}"
                                        BorderBrush="#10B981"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="6,0,0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="#10B981" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Green Pod" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                            <TextBlock Text="LEDs 9–16" FontSize="10" Foreground="{DynamicResource AppTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Yellow Pod -->
                                <Border Grid.Row="1" Grid.Column="0"
                                        Background="{DynamicResource AppCardBackground}"
                                        BorderBrush="#F59E0B"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,6,6,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="#F59E0B" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Yellow Pod" FontSize="11" FontWeight="Bold" Foreground="#F59E0B"/>
                                            <TextBlock Text="LEDs 17–24" FontSize="10" Foreground="{DynamicResource AppTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Red Pod -->
                                <Border Grid.Row="1" Grid.Column="1"
                                        Background="{DynamicResource AppCardBackground}"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="6,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="#EF4444" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Red Pod" FontSize="11" FontWeight="Bold" Foreground="#EF4444"/>
                                            <TextBlock Text="LEDs 25–32" FontSize="10" Foreground="{DynamicResource AppTextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Virtual Stage Note -->
                        <Border Background="{DynamicResource AppCardBackground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="💡" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Virtual Stage Engine"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="Live cues, fog status, and strobe dome animations are reflected in the real-time LED visualizer at the top of YALCY."
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Right Column: Connected StageKit Hardware -->
                <Border Grid.Column="1"
                        Background="{DynamicResource AppPanelBackground}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Connected StageKit Units"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}"/>
                                <TextBlock Text="Active Xbox 360 StageKit USB controllers monitored by YALCY"
                                           FontSize="11"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AppCardBackground}"
                                    BorderBrush="{DynamicResource AppBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="🔌 USB HID Monitor Active"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextSecondary}"/>
                            </Border>
                        </Grid>

                        <!-- Device Cards List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <StackPanel Spacing="10">
                                <ItemsControl ItemsSource="{Binding StageKitConnectedDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="hid:HidDevice">
                                            <Border Background="{DynamicResource AppCardBackground}"
                                                    BorderBrush="{DynamicResource AppBorderStrong}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="16,12"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                    <!-- Icon -->
                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource SystemAccentColor}"
                                                            Width="40"
                                                            Height="40"
                                                            CornerRadius="8"
                                                            Margin="0,0,14,0"
                                                            VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource IconStageKit}"
                                                                  Width="20"
                                                                  Height="20"
                                                                  Foreground="{DynamicResource SystemAccentContrastBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Device Info -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Spacing="2">
                                                        <TextBlock Text="{Binding ProductName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource AppTextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DevicePath}"
                                                                   FontSize="11"
                                                                   FontFamily="Consolas, Cascadia Code, Courier New"
                                                                   Foreground="{DynamicResource AppTextMuted}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <Border Background="{DynamicResource AppInputBackground}"
                                                                    BorderBrush="{DynamicResource AppBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding VendorID, StringFormat='VID: 0x{0:X4}'}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource AppTextSecondary}"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource AppInputBackground}"
                                                                    BorderBrush="{DynamicResource AppBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding ProductID, StringFormat='PID: 0x{0:X4}'}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource AppTextSecondary}"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource AppInputBackground}"
                                                                    BorderBrush="{DynamicResource AppBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding ReleaseNumberBcd, StringFormat='Rev: {0}'}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource AppTextSecondary}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <!-- USB HID Pill -->
                                                    <Border Grid.Column="2"
                                                            Background="{DynamicResource AppInputBackground}"
                                                            BorderBrush="{DynamicResource AppBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,5"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="🎮" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Text="STAGEKIT"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AppTextPrimary}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Expander for Raw DataGrid -->
                        <Expander Grid.Row="2"
                                  Header="Detailed Hardware Table"
                                  Margin="0,12,0,0"
                                  Background="{DynamicResource AppInputBackground}"
                                  BorderBrush="{DynamicResource AppBorder}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <DataGrid CanUserSortColumns="False"
                                      ItemsSource="{Binding StageKitConnectedDevices}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Height="140"
                                      Margin="4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Friendly Name" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="Instance ID" Binding="{Binding DevicePath}" Width="2*" />
                                    <DataGridTextColumn Header="Vendor ID" Binding="{Binding VendorID}" Width="*" />
                                    <DataGridTextColumn Header="Product ID" Binding="{Binding ProductID}" Width="*" />
                                    <DataGridTextColumn Header="Revision" Binding="{Binding ReleaseNumberBcd}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
