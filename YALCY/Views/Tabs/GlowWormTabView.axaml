<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:YALCY.ViewModels" xmlns:serial="clr-namespace:YALCY.Integrations.WledSerial"
             xmlns:components="clr-namespace:YALCY.Views.Components"
             x:Class="YALCY.Views.Tabs.GlowWormTabView" x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource AppPanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="Bold" /></Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="20,16,20,20" Spacing="12">
            <components:TabHeroHeader HeaderTitle="Glow Worm" Subtitle="Network RGB lighting for Glow Worm Luciferin" IconData="{StaticResource IconUdp}">
                <components:TabHeroHeader.BadgeContent>
                    <ToggleSwitch IsChecked="{Binding GlowWormEnabledSetting.IsEnabled, Mode=TwoWay}" OnContent="Enabled" OffContent="Disabled" />
                </components:TabHeroHeader.BadgeContent>
            </components:TabHeroHeader>
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Connection" />
                    <TextBlock Classes="hint" Text="Use Glow Worm FULL firmware on your local network. Stop Firefly capture or other senders first. Disable output before editing settings." />
                    <StackPanel Spacing="10" IsEnabled="{Binding !GlowWormEnabledSetting.IsEnabled}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8" Spacing="6"><TextBlock Text="Controller IP" /><TextBox Width="200" Text="{Binding GlowWorm.Options.Address, Mode=TwoWay}" Watermark="192.168.1.50" /></StackPanel>
                            <StackPanel Margin="0,0,12,8" Spacing="6"><TextBlock Text="UDP port" /><NumericUpDown Width="130" Minimum="1" Maximum="65535" Value="{Binding GlowWorm.Options.Port, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Margin="0,0,12,8" Spacing="6"><TextBlock Text="HTTP port" /><NumericUpDown Width="130" Minimum="1" Maximum="65535" Value="{Binding GlowWorm.Options.HttpPort, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Margin="0,0,12,8" Spacing="6"><TextBlock Text="Frame rate" /><NumericUpDown Width="130" Minimum="1" Maximum="60" Value="{Binding GlowWorm.Options.Fps, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Margin="0,0,12,8" Spacing="6"><TextBlock Text="LED count" /><NumericUpDown Width="130" Minimum="1" Maximum="2048" Value="{Binding GlowWorm.Options.Lighting.LedCount, Mode=TwoWay}" /></StackPanel>
                            <StackPanel Margin="0,0,12,8" Spacing="6"><TextBlock Text="Brightness (%)" /><NumericUpDown Width="130" Minimum="0" Maximum="100" Value="{Binding GlowWorm.Options.Lighting.Brightness, Mode=TwoWay}" /></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <CheckBox Content="Automatically turn on and select Bias light mode" IsEnabled="{Binding !GlowWormEnabledSetting.IsEnabled}" IsChecked="{Binding GlowWorm.Options.AutoControl, Mode=TwoWay}" />
                    <TextBlock Text="{Binding GlowWorm.Status}" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Text="UDP defaults to port 4210. If automatic control is off, select Bias light mode on the controller yourself. Green means sending; UDP does not confirm reception. HTTP failures appear in the log." />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="10" IsEnabled="{Binding !GlowWormEnabledSetting.IsEnabled}">
                    <TextBlock Classes="heading" Text="LED &amp; group mapping" />
                    <TextBlock Classes="hint" Text="LED numbers start at 1. Each row controls a range. A bank repeats its eight Stage Kit LEDs across that range; a numbered light drives the entire range together. Strobe uses BPM-timed white flashes. Gaps and Unassigned ranges stay black. Ranges must not overlap." />
                    <WrapPanel>
                        <Button Content="Add range" Command="{Binding GlowWorm.AddMappingCommand}" Margin="0,0,8,0" />
                        <Button Content="Remove selected" Command="{Binding GlowWorm.RemoveMappingCommand}" Margin="0,0,8,0" />
                        <Button Content="Reset to four banks" Command="{Binding GlowWorm.ResetMappingsCommand}" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="120,120,*" Margin="8,0"><TextBlock Text="First LED" /><TextBlock Grid.Column="1" Text="LED count" /><TextBlock Grid.Column="2" Text="Stage Kit assignment" /></Grid>
                    <ListBox ItemsSource="{Binding GlowWorm.Options.Lighting.Mappings}" SelectedItem="{Binding GlowWorm.SelectedMapping, Mode=TwoWay}" MaxHeight="350">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="serial:WledSerialMapping">
                                <Grid ColumnDefinitions="120,120,*">
                                    <NumericUpDown Minimum="1" Maximum="2048" Value="{Binding Start, Mode=TwoWay}" Margin="0,0,8,0" />
                                    <NumericUpDown Grid.Column="1" Minimum="1" Maximum="2048" Value="{Binding Count, Mode=TwoWay}" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="2" MinWidth="170" ItemsSource="{Binding AvailableAssignments}" SelectedItem="{Binding Assignment, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="heading" Text="Color test" />
                    <TextBlock Classes="hint" Text="Enable output, then test all configured LEDs without running YARG. The test lasts two seconds and returns to mapped lighting. Blackout overrides tests. Disabling output sends a final black frame. RGB output only; there is no independent white channel." />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding GlowWormEnabledSetting.IsEnabled}">
                        <ComboBox ItemsSource="{Binding GlowWorm.TestColors}" SelectedItem="{Binding GlowWorm.TestColor, Mode=TwoWay}" MinWidth="120" />
                        <Button Content="Test for 2 seconds" Command="{Binding GlowWorm.TestColorCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


