<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YALCY.ViewModels"
             xmlns:components="clr-namespace:YALCY.Views.Components"
             x:Class="YALCY.Views.Tabs.SystemColorsTabView"
             x:DataType="vm:SystemColorsViewModel"
             mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16" Spacing="16">
            
            <components:TabHeroHeader HeaderTitle="Windows System Colors &amp; Accent Palette"
                                      Subtitle="Live inspection of OS accent shades, brushes, surfaces, and Microsoft SystemColors"
                                      IconData="{StaticResource IconSparkle}"
                                      BadgeBackground="{DynamicResource AppAccentBadgeBackground}"
                                      BadgeBorderBrush="{DynamicResource AppAccentBadgeBorder}">
                <components:TabHeroHeader.BadgeContent>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{DynamicResource SystemAccentColor}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="Fluent SystemColors"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBadgeForeground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </components:TabHeroHeader.BadgeContent>
            </components:TabHeroHeader>

            <!-- Search and Filter Toolbar Card -->
            <Border Background="{DynamicResource AppPanelBackground}" 
                    BorderBrush="{DynamicResource AppBorder}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="16,14">
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <!-- Search Input -->
                    <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*" Margin="0,0,12,10">
                        <TextBox Text="{Binding SearchFilter, Mode=TwoWay}"
                                 Watermark="Search color name, category, hex (e.g. Accent, Highlight, #107C)..."
                                 Background="{DynamicResource AppInputBackground}"
                                 BorderBrush="{DynamicResource AppBorder}"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 Padding="12,8"
                                 FontSize="13"
                                 Foreground="{DynamicResource AppTextPrimary}"/>
                    </Grid>

                    <!-- Refresh Button -->
                    <Button Grid.Row="0" Grid.Column="1"
                            Click="OnRefreshColorsClicked"
                            Background="{DynamicResource AppCardBackground}"
                            BorderBrush="{DynamicResource AppBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,0,10,10"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip.Tip="Reload current Windows system colors and accent palette">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="12" Foreground="{DynamicResource AppTextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Total count badge -->
                    <Border Grid.Row="0" Grid.Column="2" 
                            Background="{DynamicResource AppCardBackground}"
                            BorderBrush="{DynamicResource AppBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Colors loaded:" FontSize="12" Foreground="{DynamicResource AppTextSecondary}" FontWeight="Medium"/>
                            <TextBlock Text="{Binding FilteredColors.Count}" FontSize="12" Foreground="{DynamicResource AppAccentText}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Category Pills -->
                    <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Click="OnCategoryFilterClicked"
                                             Background="{DynamicResource AppCardBackground}"
                                             BorderBrush="{DynamicResource AppBorderStrong}"
                                             BorderThickness="1"
                                             CornerRadius="6"
                                             Padding="12,5"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource AppTextSecondary}"
                                            Cursor="Hand"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Color Palette Swatch Grid -->
            <ItemsControl ItemsSource="{Binding FilteredColors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SystemColorItem">
                        <Border Background="{DynamicResource AppCardBackground}"
                                BorderBrush="{DynamicResource AppBorderStrong}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="6"
                                Width="280"
                                Padding="14">
                            <StackPanel Spacing="10">
                                <!-- Large Interactive Color Swatch Chip -->
                                <Border Background="{Binding ColorBrush}"
                                        CornerRadius="8"
                                        Height="64"
                                        BorderBrush="#40000000"
                                        BorderThickness="1"
                                        Padding="10">
                                    <Grid RowDefinitions="*,Auto" VerticalAlignment="Stretch">
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Name}" 
                                                   FontSize="13" 
                                                   FontWeight="Black" 
                                                   Foreground="{Binding TextContrastBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding HexCode}" 
                                                   FontSize="11" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding TextContrastBrush}"
                                                   Opacity="0.9"/>
                                    </Grid>
                                </Border>

                                <!-- Details & Hex Codes -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <!-- Category Tag -->
                                        <Border Background="{DynamicResource AppAccentBadgeBackground}"
                                                BorderBrush="{DynamicResource AppAccentBadgeBorder}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Category}" 
                                                       FontSize="9" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource AppAccentBadgeForeground}"/>
                                        </Border>
                                        <TextBlock Text="{Binding HexRgb}" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                    Foreground="{DynamicResource AppTextPrimary}" 
                                                   FontFamily="Consolas, Cascadia Code, Courier New"/>
                                        <TextBlock Text="{Binding RgbString}" 
                                                   FontSize="10" 
                                                    Foreground="{DynamicResource AppTextSecondary}" 
                                                   FontFamily="Consolas, Cascadia Code, Courier New"/>
                                    </StackPanel>

                                    <!-- Copy Button -->
                                    <Button Grid.Column="1"
                                            Click="OnCopyColorHexClicked"
                                            Background="{DynamicResource AppAccentBadgeBackground}"
                                            BorderBrush="{DynamicResource AppAccentBadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Copy Hex code to clipboard">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentBadgeForeground}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Description -->
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource AppTextMuted}" 
                                           TextWrapping="Wrap"
                                           LineHeight="15"
                                           MaxLines="3"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
