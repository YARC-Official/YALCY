<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:YALCY.ViewModels"
             xmlns:components="clr-namespace:YALCY.Views.Components"
             xmlns:wled="clr-namespace:YALCY.Integrations.WLED"
             x:Class="YALCY.Views.Tabs.WledTabView"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">

    <UserControl.Styles>
        <!-- Connect button base -->
        <Style Selector="Button.wled-connect-btn">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentContrastBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.wled-connect-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Connect button connecting state -->
        <Style Selector="Button.wled-connect-btn.connecting /template/ ContentPresenter">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- Connect button connected state -->
        <Style Selector="Button.wled-connect-btn.connected /template/ ContentPresenter">
            <Setter Property="Background" Value="#15803D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#22C55E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Disconnect button base (disabled) -->
        <Style Selector="Button.wled-disconnect-btn">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.wled-disconnect-btn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- Disconnect button connected state (active & clickable) -->
        <Style Selector="Button.wled-disconnect-btn.connected">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.wled-disconnect-btn.connected /template/ ContentPresenter">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#EF4444" />
            <Setter Property="Opacity" Value="1.0" />
        </Style>
        <Style Selector="Button.wled-disconnect-btn.connected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#F87171" />
        </Style>
    </UserControl.Styles>

    <!-- Keep star-sized lists bounded, but allow the page to scroll in small windows. -->
    <ScrollViewer x:Name="PageScroll"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Grid Width="{Binding #PageScroll.Viewport.Width}"
              Height="{Binding #PageScroll.Viewport.Height}"
              MinWidth="700" MinHeight="640">
    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <!-- Row 0: Hero Header -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Sleek Live LED Strip Preview Monitor -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Segmented Sub-Nav Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Active Sub-Tab Viewport -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Tab Hero Header -->
        <components:TabHeroHeader Grid.Row="0"
                                  Margin="0,0,0,16"
                                  HeaderTitle="WLED Direct Integration"
                                  Subtitle="Ultra low-latency (sub-2ms) StageKit &amp; YARG rhythm sync with native 4-channel RGBW diode control"
                                  IconData="{StaticResource IconWled}">
            <components:TabHeroHeader.BadgeContent>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ToggleSwitch ToolTip.Tip="{Binding WledEnabledSetting.ToolTip}"
                                  IsChecked="{Binding WledEnabledSetting.IsEnabled, Mode=TwoWay}"
                                  OnContent=""
                                  OffContent=""
                                  HorizontalAlignment="Right"
                                  Margin="0" />
                    <TextBlock Text="{Binding WledEnabledSetting.ToggleButtonContent}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextSecondary}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0" />
                </StackPanel>
            </components:TabHeroHeader.BadgeContent>
        </components:TabHeroHeader>

        <!-- Row 1: Ultra-Minimalist Live LED Strip Monitor -->
        <Border Grid.Row="1"
                Background="{DynamicResource AppPanelBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,7"
                Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Minimalist Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" />
                        <TextBlock Text="Live Preview"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding WledLedCount, StringFormat='{} • {0} LEDs'}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AppTextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: Minimalist Stacked CheckBox & Inline Telemetry -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding WledVisualizerStacked, Mode=TwoWay}"
                                  ToolTip.Tip="Display each detected segment on an independent lane"
                                  VerticalAlignment="Center"
                                  Padding="4,0,0,0"
                                  Margin="0">
                            <TextBlock Text="Stacked Lanes"
                                       FontSize="10"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       VerticalAlignment="Center" />
                        </CheckBox>

                        <Border Width="1" Height="10" Background="{DynamicResource AppBorderStrong}" VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WledFps, StringFormat='{}{0:F1} FPS'}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="•"
                                       FontSize="10"
                                       Foreground="{DynamicResource AppTextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WledLatencyText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding WledLatencyColor}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- High-performance GPU Canvas Component -->
                <components:WledStripVisualizer Height="{Binding WledVisualizerHeight}" />
            </StackPanel>
        </Border>

        <!-- Row 2: Modern Segmented Sub-Navigation Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource AppPanelBackground}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="4"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,*,*,*">
                <RadioButton Grid.Column="0"
                             Content="📡 Controller &amp; Hardware"
                             GroupName="WledSubNavGroup"
                             Classes="SegmentedToggle"
                             IsChecked="{Binding WledSelectedSubTab, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                             HorizontalAlignment="Stretch" Margin="0,0,2,0" />
                <RadioButton Grid.Column="1"
                             Content="🎨 StageKit &amp; Layout"
                             GroupName="WledSubNavGroup"
                             Classes="SegmentedToggle"
                             IsChecked="{Binding WledSelectedSubTab, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                             HorizontalAlignment="Stretch" Margin="2,0,2,0" />
                <RadioButton Grid.Column="2"
                             Content="⚡ Rhythm &amp; Strobes"
                             GroupName="WledSubNavGroup"
                             Classes="SegmentedToggle"
                             IsChecked="{Binding WledSelectedSubTab, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"
                             HorizontalAlignment="Stretch" Margin="2,0,2,0" />
                <RadioButton Grid.Column="3"
                             Content="🧪 Diagnostics &amp; Telemetry"
                             GroupName="WledSubNavGroup"
                             Classes="SegmentedToggle"
                             IsChecked="{Binding WledSelectedSubTab, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}"
                             HorizontalAlignment="Stretch" Margin="2,0,0,0" />
            </Grid>
        </Border>

        <!-- Row 3: Active Sub-Tab Viewport (Clean 2-Column Responsive ScrollViewer) -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,10">

                <!-- ========================================================================= -->
                <!-- SUB-TAB 0: CONTROLLER & HARDWARE                                          -->
                <!-- ========================================================================= -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16"
                      IsVisible="{Binding WledSelectedSubTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}">

                    <!-- Left Card: WLED Server Connection & Protocol -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="📡 WLED Controller Connection"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}" />
                                <!-- Live Connection Status Badge -->
                                <Border Grid.Column="1"
                                        Background="{DynamicResource AppCardBackground}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="{Binding WledConnectionBadgeColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding WledConnectionBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding WledConnectionBadgeColor}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- IP Address & Action Buttons -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Controller IP Address or Hostname"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextSecondary}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding WledServerIp, Mode=TwoWay}"
                                             Watermark="192.168.1.100 (e.g. wled.local)"
                                             IsEnabled="{Binding !IsWledConnected}"
                                             VerticalContentAlignment="Center"
                                             Height="36" />
                                    <Button Grid.Column="1"
                                            Classes="wled-connect-btn"
                                            Classes.connecting="{Binding IsWledConnecting}"
                                            Classes.connected="{Binding IsWledConnected}"
                                            Content="{Binding WledConnectButtonText}"
                                            Command="{Binding ConnectWledCommand}"
                                            IsEnabled="{Binding CanConnectWled}"
                                            IsVisible="{Binding !IsWledConnected}"
                                            Height="36"
                                            Padding="14,0"
                                            VerticalContentAlignment="Center"
                                            FontWeight="SemiBold"
                                            CornerRadius="7" />
                                    <Button Grid.Column="1"
                                            Classes="wled-disconnect-btn"
                                            Classes.connected="{Binding IsWledConnected}"
                                            Content="⏹ Disconnect"
                                            Command="{Binding DisconnectWledCommand}"
                                            IsEnabled="{Binding CanDisconnectWled}"
                                            IsVisible="{Binding IsWledConnected}"
                                            Height="36"
                                            Padding="14,0"
                                            VerticalContentAlignment="Center"
                                            FontWeight="SemiBold"
                                            CornerRadius="7" />
                                </Grid>
                                <!-- Connection Wait / Activity Progress Bar -->
                                <ProgressBar IsIndeterminate="True"
                                             Height="3"
                                             CornerRadius="2"
                                             Background="Transparent"
                                             Foreground="#FFA726"
                                             IsVisible="{Binding IsWledConnecting}"
                                             Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Protocol & UDP Port (Crisp, never-clipped display) -->
                            <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Streaming Protocol"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextSecondary}" />
                                    <ComboBox SelectedIndex="{Binding WledProtocol, Mode=TwoWay}"
                                              IsEnabled="{Binding !IsWledConnected}"
                                              HorizontalAlignment="Stretch"
                                              Height="36">
                                        <ComboBoxItem Content="DDP RGB (Port 4048 • WS2812B • Recommended)" />
                                        <ComboBoxItem Content="DDP RGBW (Port 4048 • SK6812 • Recommended for RGBW)" />
                                        <ComboBoxItem Content="Realtime DRGB (Port 21324 • WS2812B • Legacy)" />
                                        <ComboBoxItem Content="Realtime DRGBW (Port 21324 • SK6812 • Legacy)" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="UDP Port"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextSecondary}" />
                                    <NumericUpDown Value="{Binding WledServerPort, Mode=TwoWay}"
                                                   IsEnabled="{Binding !IsWledConnected}"
                                                   Minimum="1"
                                                   Maximum="65535"
                                                   FormatString="0"
                                                   ShowButtonSpinner="False"
                                                   Height="36"
                                                   HorizontalContentAlignment="Center"
                                                   VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Active Protocol Description Card -->
                            <Border Background="{DynamicResource AppInputBackground}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding WledProtocolTitle}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimary}" />
                                    <TextBlock Text="{Binding WledProtocolDescription}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Timeout Setting -->
                            <Grid ColumnDefinitions="*,100" ColumnSpacing="10">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Socket Keepalive Timeout"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimary}" />
                                    <TextBlock Text="Resets strip to ambient when packets cease"
                                               FontSize="10"
                                               Foreground="{DynamicResource AppTextSecondary}" />
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding WledTimeoutSeconds, Mode=TwoWay}"
                                               Minimum="1"
                                               Maximum="30"
                                               FormatString="{}{0} s"
                                               ShowButtonSpinner="False"
                                               Height="34"
                                               HorizontalContentAlignment="Center"
                                               VerticalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Multi-Strip Routing & Remote ESP32s -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <!-- Strip Geometry -->
                        <Border Background="{DynamicResource AppPanelBackground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="📐 Physical Strip Geometry"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextPrimary}" />

                                <Grid ColumnDefinitions="*,100" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Physical LED Count"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="Total diodes across the strip (1..1200)"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding WledLedCount, Mode=TwoWay}"
                                                   Minimum="1"
                                                   Maximum="1200"
                                                   FormatString="0"
                                                   ShowButtonSpinner="False"
                                                   Height="34"
                                                   HorizontalContentAlignment="Center"
                                                   VerticalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,100" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Start LED Offset"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="Skips initial diodes on installation strip"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding WledStartOffset, Mode=TwoWay}"
                                                   Minimum="0"
                                                   Maximum="1199"
                                                   FormatString="0"
                                                   ShowButtonSpinner="False"
                                                   Height="34"
                                                   HorizontalContentAlignment="Center"
                                                   VerticalContentAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Invert Direction (Reverse Strip)"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="For strips wired from right-to-left"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsChecked="{Binding WledReverseDirection, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent="" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Multi-Strip Routing & Remote ESP32s -->
                        <Border Background="{DynamicResource AppPanelBackground}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="🎛️ Multi-Strip Routing &amp; Segments"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="Per-strip StageKit distribution &amp; ESP32 channel routing"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="🔍 Scan Segments"
                                            Command="{Binding ScanWledSegmentsCommand}"
                                            Padding="10,6"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                </Grid>

                                <ComboBox SelectedIndex="{Binding WledMultiStripMode, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="🔗 Contiguous (Single Linear Strip)" />
                                    <ComboBoxItem Content="🪞 Mirror / Clone Per Strip (Symmetrical Left/Right)" />
                                    <ComboBoxItem Content="🔁 Phase-Aligned Tile Per Strip (Sync at Pod 1)" />
                                    <ComboBoxItem Content="🎭 Role-Based Strip Assignment (Lights / Strobe / Ambient)" />
                                </ComboBox>

                                <Border Background="{DynamicResource AppInputBackground}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="10,7">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding WledMultiStripTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                        <TextBlock Text="{Binding WledMultiStripDescription}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Detected segments mini-list -->
                                <ItemsControl ItemsSource="{Binding WledSegments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="wled:WledSegment">
                                            <Border Background="{DynamicResource AppCardBackground}"
                                                    BorderBrush="{DynamicResource AppBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    Margin="0,0,0,4">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#60A5FA" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayRange}" FontSize="10" Foreground="{DynamicResource AppTextPrimary}" />
                                                    <TextBlock Grid.Column="2" Text="REV" FontSize="9" FontWeight="Bold" Foreground="#FFA726" IsVisible="{Binding IsReversed}" />
                                                    <Ellipse Grid.Column="3" Width="6" Height="6" Fill="#4CAF50" IsVisible="{Binding IsOn}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Multi-ESP32 Network Broadcast section -->
                                <Separator Background="{DynamicResource AppBorder}" Margin="0,4" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🌐 Multi-ESP32 Broadcast" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="Stream simultaneously to secondary controllers" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="➕ Add Controller" Command="{Binding AddAdditionalControllerCommand}" Padding="8,4" FontSize="10" FontWeight="SemiBold" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding WledAdditionalControllers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WledControllerViewModel">
                                            <Border Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,*,Auto,Auto" ColumnSpacing="6">
                                                    <ToggleSwitch Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" OnContent="" OffContent="" Margin="0" />
                                                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" Watermark="Controller Name" FontSize="11" Height="28" VerticalContentAlignment="Center" />
                                                    <TextBox Grid.Column="2" Text="{Binding IpAddress, Mode=TwoWay}" Watermark="IP Address" FontSize="11" Height="28" VerticalContentAlignment="Center" />
                                                    <Button Grid.Column="3" Content="⚡ Ping" Command="{Binding TestCommand}" Padding="6,3" FontSize="9" FontWeight="SemiBold" />
                                                    <Button Grid.Column="4" Content="🗑" Command="{Binding RemoveCommand}" Padding="6,3" FontSize="10" Foreground="#EF4444" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ========================================================================= -->
                <!-- SUB-TAB 1: STAGEKIT & LAYOUT                                              -->
                <!-- ========================================================================= -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16"
                      IsVisible="{Binding WledSelectedSubTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}">

                    <!-- Left Card: StageKit Strip Layout Mapping & Tuning -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="🎭 StageKit Strip Layout Mapping"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <ComboBox SelectedIndex="{Binding WledLayoutMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="🔁 Tiled Repeat (1..32 repeated in loop across strip)" />
                                <ComboBoxItem Content="🎯 Proportional Stretch (32 StageKit LEDs scaled across strip)" />
                                <ComboBoxItem Content="🚥 4 Distinct Stage Pods (Blue, Red, Green, Yellow)" />
                                <ComboBoxItem Content="🪞 Symmetrical Center Split (Concert truss / drum riser)" />
                                <ComboBoxItem Content="📍 Direct 1-to-1 Mapping (Indices 0..31)" />
                                <ComboBoxItem Content="🌈 Full Stage Color Wash (Dominant / Harmonic stage color)" />
                                <ComboBoxItem Content="〰 Smooth Gradient Wave (Fluid color cycle across pods)" />
                            </ComboBox>

                            <Border Background="{DynamicResource AppInputBackground}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding WledLayoutTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    <TextBlock Text="{Binding WledLayoutDescription}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Layout Tuning Options Panel -->
                            <Border Background="{DynamicResource AppCardBackground}"
                                    BorderBrush="{DynamicResource AppBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,12">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="⚙ Layout Tuning Parameters" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimary}" />

                                    <!-- 1. Tiled Repeat Tuning -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsTiledRepeatActive}">
                                        <TextBlock Text="Tile Repeat Style" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                        <ComboBox SelectedIndex="{Binding WledRepeatStyle, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Loop 1..32 (Direct wrap from end to start)" />
                                            <ComboBoxItem Content="Ping-Pong (Bounces forward and backward)" />
                                        </ComboBox>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Tile Block Size" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding WledRepeatTileSize, StringFormat='{}{0} LEDs'}" FontSize="11" Foreground="{DynamicResource AppAccentText}" />
                                        </Grid>
                                        <Slider Value="{Binding WledRepeatTileSize, Mode=TwoWay}" Minimum="8" Maximum="64" />

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Block Gap Spacing" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding WledLayoutGapLeds, StringFormat='{}{0} LEDs'}" FontSize="11" Foreground="{DynamicResource AppAccentText}" />
                                        </Grid>
                                        <Slider Value="{Binding WledLayoutGapLeds, Mode=TwoWay}" Minimum="0" Maximum="16" />
                                    </StackPanel>

                                    <!-- 2. Proportional Stretch Tuning -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsProportionalStretchActive}">
                                        <TextBlock Text="Interpolation Mode" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                        <ComboBox SelectedIndex="{Binding WledStretchInterpolation, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Linear Crossfade (Smooth blend between pixels)" />
                                            <ComboBoxItem Content="Nearest Neighbor (Crisp discrete diode blocks)" />
                                        </ComboBox>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Strip Edge Margin / Padding" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding WledStretchPadding, StringFormat='{}{0} LEDs'}" FontSize="11" Foreground="{DynamicResource AppAccentText}" />
                                        </Grid>
                                        <Slider Value="{Binding WledStretchPadding, Mode=TwoWay}" Minimum="0" Maximum="32" />
                                    </StackPanel>

                                    <!-- 3. Four Quadrant Pods Tuning -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsFourQuadrantPodsActive}">
                                        <TextBlock Text="Pod Color Order" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                        <ComboBox SelectedIndex="{Binding WledPodColorOrder, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Blue → Red → Green → Yellow (Default)" />
                                            <ComboBoxItem Content="Yellow → Green → Red → Blue (Reversed)" />
                                            <ComboBoxItem Content="Red → Yellow → Blue → Green (Warm to Cool)" />
                                        </ComboBox>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Pod Gap Spacing" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding WledPodGapLeds, StringFormat='{}{0} LEDs'}" FontSize="11" Foreground="{DynamicResource AppAccentText}" />
                                        </Grid>
                                        <Slider Value="{Binding WledPodGapLeds, Mode=TwoWay}" Minimum="0" Maximum="20" />
                                    </StackPanel>

                                    <!-- 4. Center Split Tuning -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsCenterSplitActive}">
                                        <TextBlock Text="Mirror Direction" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                        <ComboBox SelectedIndex="{Binding WledCenterSplitDirection, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Center Outward (Center expands to strip ends)" />
                                            <ComboBoxItem Content="Ends Toward Center (Outer edges mirror inward)" />
                                        </ComboBox>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Center Point Offset" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding WledCenterSplitOffset, StringFormat='{}{0} LEDs'}" FontSize="11" Foreground="{DynamicResource AppAccentText}" />
                                        </Grid>
                                        <Slider Value="{Binding WledCenterSplitOffset, Mode=TwoWay}" Minimum="-30" Maximum="30" />
                                    </StackPanel>

                                    <!-- 5. Direct 1:1 Tuning -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsDirect1to1Active}">
                                        <TextBlock Text="Excess LEDs Behavior (&gt; LED 31)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                        <ComboBox SelectedIndex="{Binding WledDirectExcessMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Blackout (Unused LEDs powered off)" />
                                            <ComboBoxItem Content="Repeat 32 Pattern (Tiles 32 across remaining)" />
                                            <ComboBoxItem Content="Hold Last Color (Extends color of LED 31)" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 6. Full Wash Tuning -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsFullWashActive}">
                                        <TextBlock Text="Wash Color Blend Mode" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                        <ComboBox SelectedIndex="{Binding WledWashBlendMode, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Harmonic Average (Smooth mix of active pods)" />
                                            <ComboBoxItem Content="Dominant Pod (Highest intensity color takes over)" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 7. Smooth Gradient Tuning -->
                                    <StackPanel Spacing="10" IsVisible="{Binding IsSmoothGradientActive}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Wave Cycles Across Strip" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding WledGradientCycles, StringFormat='{}{0}x'}" FontSize="11" Foreground="{DynamicResource AppAccentText}" />
                                        </Grid>
                                        <Slider Value="{Binding WledGradientCycles, Mode=TwoWay}" Minimum="1" Maximum="4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Diode Calibration & Brightness Safety Limiter -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="💡 Diode Calibration &amp; Brightness"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextPrimary}" />
                                    <TextBlock Text="Real-time brightness scaling, white balance &amp; hardware safety limiter"
                                               FontSize="10"
                                               Foreground="{DynamicResource AppTextSecondary}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding WledCalibrationPreviewEnabled, Mode=TwoWay}"
                                              ToolTip.Tip="Toggle live reference test pattern to calibrate brightness &amp; white balance in real time"
                                              OnContent="Preview Active"
                                              OffContent="Preview Off"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <!-- Master RGB Brightness -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Master RGB Brightness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding WledBrightness, StringFormat='{}{0} / 255'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    </Border>
                                </Grid>
                                <Slider Value="{Binding WledBrightness, Mode=TwoWay}" Minimum="0" Maximum="255" />
                            </StackPanel>

                            <!-- Dedicated 4th Channel (White) Brightness -->
                            <StackPanel Spacing="6" IsEnabled="{Binding IsRgbwProtocol}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Dedicated 4th Channel (White) Brightness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding WledWhiteChannelBrightness, StringFormat='{}{0} / 255'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    </Border>
                                </Grid>
                                <Slider Value="{Binding WledWhiteChannelBrightness, Mode=TwoWay}" Minimum="0" Maximum="255" />
                            </StackPanel>

                            <!-- Hardware Safety Limiter -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Hardware Safety Max Brightness Limiter" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="Caps peak output to protect 5V/12V PSUs from overcurrent" FontSize="10" Foreground="{DynamicResource AppTextMuted}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#261E10" BorderBrush="#FFA726" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WledMaxBrightnessLimit, StringFormat='{}Max {0}'}" FontSize="10" FontWeight="Bold" Foreground="#FFA726" />
                                    </Border>
                                </Grid>
                                <Slider Value="{Binding WledMaxBrightnessLimit, Mode=TwoWay}" Minimum="10" Maximum="255" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- SUB-TAB 2: RHYTHM & STROBES                                               -->
                <!-- ========================================================================= -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16"
                      IsVisible="{Binding WledSelectedSubTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}">

                    <!-- Left Card: Dynamic Rhythm & Musical Accents (YARG) -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel Spacing="14">
                            <TextBlock Text="⚡ Dynamic Rhythm &amp; Stage Sync (YARG)"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <!-- Master Rhythm Switch -->
                            <CheckBox IsChecked="{Binding WledRhythmicWhiteAccent, Mode=TwoWay}"
                                      IsEnabled="{Binding IsRhythmicWhiteAllowed}"
                                      ToolTip.Tip="Active in 'Rhythm + Strobe' mode. In 'Strobe Only' or 'Disabled' mode, white channel is not modulated by rhythm.">
                                <StackPanel>
                                    <TextBlock Text="Enable Rhythmic White Layer Modulation" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Modulates dedicated White diodes on live musical impulses over ambient colors" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                </StackPanel>
                            </CheckBox>

                            <Separator Background="{DynamicResource AppBorder}" Margin="0,2" />

                            <!-- Snare Hit Flash Accent & Slider -->
                            <StackPanel Spacing="6" IsEnabled="{Binding IsRhythmicWhiteActive}">
                                <CheckBox IsChecked="{Binding WledSnareFlashEnabled, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="Instant Snare &amp; Drum Flash Accents" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="Fires millisecond neutral white flashes on drum hits" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                </CheckBox>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,2">
                                    <TextBlock Grid.Column="0" Text="Snare Flash Intensity" FontSize="11" Foreground="{DynamicResource AppTextSecondary}" />
                                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding WledSnareFlashIntensity, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    </Border>
                                </Grid>
                                <Slider Value="{Binding WledSnareFlashIntensity, Mode=TwoWay}" Minimum="0" Maximum="255" IsEnabled="{Binding WledSnareFlashEnabled}" />
                            </StackPanel>

                            <!-- Beat Line Pulse Intensity -->
                            <StackPanel Spacing="6" IsEnabled="{Binding IsRhythmicWhiteActive}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Beat Line Rhythm Pulse Intensity" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="Subtle rhythmic pump synchronized to tempo beat bars" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WledBeatPulseIntensity, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    </Border>
                                </Grid>
                                <Slider Value="{Binding WledBeatPulseIntensity, Mode=TwoWay}" Minimum="0" Maximum="255" />
                            </StackPanel>

                            <!-- Star Power Surge -->
                            <CheckBox IsChecked="{Binding WledStarPowerPulseEnabled, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Star Power / Overdrive Energy Surge" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Pulses high-intensity white &amp; gold energy while Star Power is deployed" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                </StackPanel>
                            </CheckBox>

                            <!-- Ambient Fog Haze -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ambient Fog Machine Haze Boost" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimary}" />
                                        <TextBlock Text="Atmospheric background haze level when fog is deployed" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WledFogHazeBoost, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    </Border>
                                </Grid>
                                <Slider Value="{Binding WledFogHazeBoost, Mode=TwoWay}" Minimum="0" Maximum="255" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Strobe & Blinder Diode Control -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🚨 Strobe &amp; Blinder Diode Control"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <!-- White Diode Mode (3-Way Segmented Toggle) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="White (W) Channel Diode Mode" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                                    <RadioButton Grid.Column="0" Content="Rhythm + Strobe" GroupName="WledWhiteChannelModeGroup"
                                                 IsEnabled="{Binding IsRgbwProtocol}"
                                                 IsChecked="{Binding WledWhiteStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                 Classes="SegmentedToggle" HorizontalAlignment="Stretch" Margin="0,0,3,0"
                                                 ToolTip.Tip="Full mode: White channel fires on snare hits, beat pulse, and strobe blinders" />
                                    <RadioButton Grid.Column="1" Content="Strobe Only" GroupName="WledWhiteChannelModeGroup"
                                                 IsEnabled="{Binding IsRgbwProtocol}"
                                                 IsChecked="{Binding WledWhiteStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                                 Classes="SegmentedToggle" HorizontalAlignment="Stretch" Margin="3,0,3,0"
                                                 ToolTip.Tip="White channel is reserved exclusively for strobe blinders. Rhythm and drums use RGB only" />
                                    <RadioButton Grid.Column="2" Content="Disabled (Off)" GroupName="WledWhiteChannelModeGroup"
                                                 IsChecked="{Binding WledWhiteStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"
                                                 Classes="SegmentedToggle" HorizontalAlignment="Stretch" Margin="3,0,0,0"
                                                 ToolTip.Tip="White channel never illuminates (W=0). All effects and strobes use RGB only" />
                                </Grid>

                                <Border Background="{DynamicResource AppInputBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding WledWhiteModeDescription}" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <!-- Strobe Trigger Mode (2-Way Segmented Toggle) -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Strobe Trigger Mode" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                                    <RadioButton Grid.Column="0" Content="Strobe command" GroupName="WledStrobeRadioGroup"
                                                 IsChecked="{Binding WledStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                                 Classes="SegmentedToggle" HorizontalAlignment="Stretch" Margin="0,0,3,0" />
                                    <RadioButton Grid.Column="1" Content="Manual flash strobe" GroupName="WledStrobeRadioGroup"
                                                 IsChecked="{Binding WledStrobeMode, Mode=TwoWay, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                                 Classes="SegmentedToggle" HorizontalAlignment="Stretch" Margin="3,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- SUB-TAB 3: DIAGNOSTICS & TELEMETRY                                        -->
                <!-- ========================================================================= -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16"
                      IsVisible="{Binding WledSelectedSubTab, Converter={StaticResource IntToBoolConverter}, ConverterParameter=3}">

                    <!-- Left Card: Hardware Diagnostics & Instant Color Tests -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel Spacing="16">
                            <TextBlock Text="🧪 Hardware Diagnostics &amp; Instant Tests"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <!-- Single Color Quick Firing Buttons -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Instant Single-Color Hardware Verification:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="🔴 Red" Command="{Binding TestWledRedCommand}" Margin="0,0,6,6" Padding="12,7" FontSize="11" FontWeight="SemiBold" />
                                    <Button Content="🟢 Green" Command="{Binding TestWledGreenCommand}" Margin="0,0,6,6" Padding="12,7" FontSize="11" FontWeight="SemiBold" />
                                    <Button Content="🔵 Blue" Command="{Binding TestWledBlueCommand}" Margin="0,0,6,6" Padding="12,7" FontSize="11" FontWeight="SemiBold" />
                                    <Button Content="🟡 Yellow" Command="{Binding TestWledYellowCommand}" Margin="0,0,6,6" Padding="12,7" FontSize="11" FontWeight="SemiBold" />
                                    <Button Content="⚪ White (W)" Command="{Binding TestWledPureWhiteCommand}" IsEnabled="{Binding IsRgbwProtocol}" Margin="0,0,6,6" Padding="12,7" FontSize="11" FontWeight="SemiBold" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- Stage Effect Test Buttons -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Stage Effect Simulations:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondary}" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="⚡ Pure White Blinder (W=255)"
                                            Command="{Binding TestWledWhiteBlinderCommand}"
                                            IsEnabled="{Binding IsRgbwProtocol}"
                                            Margin="0,0,8,8" Padding="12,7"
                                            Background="{DynamicResource SystemAccentColor}"
                                            Foreground="{DynamicResource SystemAccentContrastBrush}"
                                            FontWeight="SemiBold" />
                                    <Button Content="🚥 4 Stage Pods (B, R, G, Y)" Command="{Binding TestWledStagePodsCommand}" Margin="0,0,8,8" Padding="12,7" FontWeight="SemiBold" />
                                    <Button Content="🌈 RGBW Chase" Command="{Binding TestWledColorChaseCommand}" Margin="0,0,8,8" Padding="12,7" FontWeight="SemiBold" />
                                    <Button Content="⬛ Blackout Strip" Command="{Binding WledBlackoutCommand}" Margin="0,0,8,8" Padding="12,7" Background="#801010" Foreground="White" FontWeight="SemiBold" />
                                    <Button Content="🔄 Reset Defaults" Command="{Binding ResetWledDefaultsCommand}" Margin="0,0,8,8" Padding="12,7" FontWeight="SemiBold" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Live Telemetry & Transmission Diagnostics -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource AppPanelBackground}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18">
                        <StackPanel Spacing="16">
                            <TextBlock Text="📊 Live Telemetry &amp; Diagnostics"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextPrimary}" />

                            <!-- Status text -->
                            <Border Background="{DynamicResource AppCardBackground}"
                                    BorderBrush="{DynamicResource AppBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding WledStatus}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppTextPrimary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding WledMessage}" FontSize="11" Foreground="#E53935" IsVisible="{Binding WledMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </Border>

                            <!-- Stat metrics -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <Border Grid.Column="0" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Packets Sent" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                        <TextBlock Text="{Binding WledPacketsSent, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Transfer Rate" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                        <TextBlock Text="{Binding WledFps, StringFormat='{}{0:F1} FPS'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppAccentText}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource AppCardBackground}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="Packet Latency" FontSize="10" Foreground="{DynamicResource AppTextSecondary}" />
                                        <TextBlock Text="{Binding WledLatencyDetailedText}" FontSize="15" FontWeight="Bold" Foreground="{Binding WledLatencyColor}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
