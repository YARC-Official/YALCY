{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/YALCY.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/YALCY.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/YALCY.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-single-file",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/YALCY.csproj",
                "-c",
                "Release",
                "-p:PublishSingleFile=true",
                "-o",
                "${workspaceFolder}/publish"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "open-single-file-app",
            "type": "shell",
            "windows": {
                "command": "cmd",
                "args": ["/c", "start", "", "${workspaceFolder}\\publish\\YALCY.exe"]
            },
            "osx": {
                "command": "open",
                "args": ["${workspaceFolder}/publish/YALCY"]
            },
            "linux": {
                "command": "sh",
                "args": ["-c", "\"${workspaceFolder}/publish/YALCY\" &"]
            },
            "problemMatcher": []
        },
        {
            "label": "Publish & Run",
            "dependsOrder": "sequence",
            "dependsOn": [
                "publish-single-file",
                "open-single-file-app"
            ],
            "problemMatcher": []
        }
    ]
}